{
  "manifest_version": 3,
  "name": "Pachakutech Presence",
  "version": "0.1.0",
  "description": "Send checked tabs to the presence runtime.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "activeTab", "scripting", "contextMenus"],
  "action": {
    "default_title": "Send tabs",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}

#version 450
// Skin the proxy and rebuild one AnimatedSplat per bound sample.
// This is ProxyMesh::skin then Reconstructor::reconstruct: morph, then
// four-influence linear blend of the skin matrices, then one triangle
// frame. The matrices are column-major, the same 16 floats as Mat4.
// Rotation out is (w, x, y, z). A degenerate triangle keeps the posed
// barycentric point and uses the rest frame. A non-finite result is the
// rest barycentric point and the identity quaternion, with no offset.
// Output is rigid: joint 0, weight 1. The 64-slot palette is not read.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct AnimatedSplat {
    vec4 position_and_confidence;
    vec4 rotation;
    vec4 color;
    uvec4 joint_ids;
    vec4 weights;
    uint owner_id;
    uint last_visible_frame;
    uint flags;
    uint padding;
};

struct Rec {
    uint tri;
    float b1;
    float b2;
    float off0;
    float off1;
    float off2;
    float pad0;
    float pad1;
};

struct TriFrame {
    vec4 e1;
    vec4 e2;
    vec4 n;
};

layout(std430, set = 0, binding = 0) readonly buffer RestPos { vec4 rest_pos[]; };
layout(std430, set = 0, binding = 1) readonly buffer Joints { uvec4 joints[]; };
layout(std430, set = 0, binding = 2) readonly buffer Weights { vec4 weights[]; };
layout(std430, set = 0, binding = 3) readonly buffer Indices { uint indices[]; };
layout(std430, set = 0, binding = 4) readonly buffer Records { Rec recs[]; };
layout(std430, set = 0, binding = 5) readonly buffer RestFrames { TriFrame rest_frames[]; };
layout(std430, set = 0, binding = 6) readonly buffer Colors { vec4 colors[]; };
layout(std430, set = 0, binding = 7) readonly buffer MorphDeltas { vec4 morph_deltas[]; };
layout(std430, set = 0, binding = 8) readonly buffer MorphWeights { float morph_w[]; };
layout(std430, set = 0, binding = 9) readonly buffer SkinMats { mat4 mats[]; };
layout(std430, set = 0, binding = 10) writeonly buffer OutSplats { AnimatedSplat splats[]; };

layout(push_constant) uniform PC {
    layout(offset = 0) uint slot_base;
    layout(offset = 4) uint splat_count;
    layout(offset = 8) uint vert_count;
    layout(offset = 12) uint tri_count;
    layout(offset = 16) uint joint_count;
    layout(offset = 20) uint morph_count;
    layout(offset = 24) uint owner_id;
    layout(offset = 28) uint frame;
    layout(offset = 32) uint flags;
    layout(offset = 36) uint density;
} pc;

bool good_len(float l) {
    return l > 1e-9 && !isnan(l) && !isinf(l);
}

bool good_vec(vec3 v) {
    return !isnan(v.x) && !isnan(v.y) && !isnan(v.z)
        && !isinf(v.x) && !isinf(v.y) && !isinf(v.z);
}

void accum(uint ji, float wk, vec3 p, inout vec3 o, inout float ws) {
    if (wk > 0.0 && ji < pc.joint_count) {
        vec3 q = (mats[ji] * vec4(p, 1.0)).xyz;
        o += wk * q;
        ws += wk;
    }
}

vec3 skin_vert(uint vi) {
    vec3 p = rest_pos[vi].xyz;
    for (uint m = 0u; m < pc.morph_count; m++) {
        float w = morph_w[m];
        if (w != 0.0) {
            p += w * morph_deltas[m * pc.vert_count + vi].xyz;
        }
    }
    uvec4 j = joints[vi];
    vec4 w = weights[vi];
    vec3 o = vec3(0.0);
    float ws = 0.0;
    accum(j.x, w.x, p, o, ws);
    accum(j.y, w.y, p, o, ws);
    accum(j.z, w.z, p, o, ws);
    accum(j.w, w.w, p, o, ws);
    if (ws > 1e-6) return o / ws;
    return p;
}

// xyzw, matching quat_from_columns then quat_normalize.
vec4 quat_from_columns(vec3 c0, vec3 c1, vec3 c2) {
    float m00 = c0.x, m10 = c0.y, m20 = c0.z;
    float m01 = c1.x, m11 = c1.y, m21 = c1.z;
    float m02 = c2.x, m12 = c2.y, m22 = c2.z;
    float tr = m00 + m11 + m22;
    vec4 q;
    if (tr > 0.0) {
        float s = sqrt(tr + 1.0) * 2.0;
        q = vec4((m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s);
    } else if (m00 > m11 && m00 > m22) {
        float s = sqrt(1.0 + m00 - m11 - m22) * 2.0;
        q = vec4(0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s);
    } else if (m11 > m22) {
        float s = sqrt(1.0 + m11 - m00 - m22) * 2.0;
        q = vec4((m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s);
    } else {
        float s = sqrt(1.0 + m22 - m00 - m11) * 2.0;
        q = vec4((m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s);
    }
    float n = sqrt(dot(q, q));
    if (n > 1e-12 && !isnan(n) && !isinf(n)) q /= n;
    else q = vec4(0.0, 0.0, 0.0, 1.0);
    return q;
}

bool tri_frame(vec3 v0, vec3 v1, vec3 v2, out vec3 e1, out vec3 e2, out vec3 nrm) {
    e1 = vec3(1.0, 0.0, 0.0);
    e2 = vec3(0.0, 1.0, 0.0);
    nrm = vec3(0.0, 0.0, 1.0);
    vec3 a = v1 - v0;
    float l1 = sqrt(dot(a, a));
    if (!good_len(l1)) return false;
    e1 = a / l1;
    vec3 cr = cross(a, v2 - v0);
    float ln = sqrt(dot(cr, cr));
    if (!good_len(ln)) return false;
    nrm = cr / ln;
    vec3 e2r = cross(nrm, e1);
    float l2 = sqrt(dot(e2r, e2r));
    if (!good_len(l2)) return false;
    e2 = e2r / l2;
    return true;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.splat_count) return;

    Rec rec = recs[id];
    uint t = rec.tri;
    if (t >= pc.tri_count) return;
    uint i0 = indices[3u * t];
    uint i1 = indices[3u * t + 1u];
    uint i2 = indices[3u * t + 2u];
    if (i0 >= pc.vert_count || i1 >= pc.vert_count || i2 >= pc.vert_count) return;

    vec3 v0 = skin_vert(i0);
    vec3 v1 = skin_vert(i1);
    vec3 v2 = skin_vert(i2);

    vec3 e1, e2, nrm;
    if (!tri_frame(v0, v1, v2, e1, e2, nrm)) {
        TriFrame rf = rest_frames[t];
        e1 = rf.e1.xyz;
        e2 = rf.e2.xyz;
        nrm = rf.n.xyz;
    }
    vec4 q = quat_from_columns(e1, e2, nrm);
    vec4 rot = vec4(q.w, q.x, q.y, q.z);

    float b0 = max(1.0 - rec.b1 - rec.b2, 0.0);
    float b1 = rec.b1;
    float b2 = rec.b2;
    vec3 p = b0 * v0 + b1 * v1 + b2 * v2;
    // off is (along normal, along e1, along e2).
    p += rec.off0 * nrm + rec.off1 * e1 + rec.off2 * e2;

    if (!(good_vec(p) && good_vec(rot.xyz) && !isnan(rot.w) && !isinf(rot.w))) {
        vec3 a = rest_pos[i0].xyz;
        vec3 b = rest_pos[i1].xyz;
        vec3 c = rest_pos[i2].xyz;
        p = b0 * a + b1 * b + b2 * c;
        rot = vec4(1.0, 0.0, 0.0, 0.0);
    }

    AnimatedSplat s;
    s.position_and_confidence = vec4(p, 1.0);
    s.rotation = rot;
    s.color = colors[t];
    s.joint_ids = uvec4(0u);
    s.weights = vec4(1.0, 0.0, 0.0, 0.0);
    s.owner_id = pc.owner_id;
    s.last_visible_frame = pc.frame;
    s.flags = pc.flags;
    s.padding = pc.density;
    splats[pc.slot_base + id] = s;
}
